    "You’re offline. Usable saved Catalogue data remains available." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет подключения к сети. Пригодный сохранённый каталог остаётся доступен." } } } },
    "Your next Episode will appear here" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Здесь появится следующая серия" } } } }
