    "NOW SELECTING" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ВЫБОР ПРОСМОТРА" } } } },
    "Playback becomes available only after protected playback integration is qualified." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Просмотр станет доступен только после проверки защищённой интеграции воспроизведения." } } } },
    "Playback Unavailable" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Просмотр недоступен" } } } },
    "PUBLIC DISCOVERY" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ОТКРЫТЫЙ КАТАЛОГ" } } } },
    "Recently updated Series" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Недавно обновлённые сериалы" } } } },
    "Refresh" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновить" } } } },
    "Retry Series" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повторить загрузку сериала" } } } },
