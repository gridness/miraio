{
  "sourceLanguage" : "en",
  "strings" : {
    "ANIME365 PROFILE" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ПРОФИЛЬ ANIME365" } } } },
    "Anime365 did not accept these sign-in details." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Anime365 не принял эти данные для входа." } } } },
    "Anime365 Profile" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Профиль Anime365" } } } },
    "Cancel" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отмена" } } } },
    "Credentials Unavailable" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Учётные данные недоступны" } } } },
    "Email" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Электронная почта" } } } },
    "Miraio couldn’t reach Anime365. Your password was cleared. Try again." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Miraio не удалось подключиться к Anime365. Пароль очищен. Повторите попытку." } } } },
    "Miraio exchanges these details for an Access Token. Your email and password are not saved." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Miraio обменивает эти данные на Access Token. Электронная почта и пароль не сохраняются." } } } },
    "Open Anime365" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть Anime365" } } } },
    "Password" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пароль" } } } },
    "Protected access is disabled, but the Access Token could not be deleted. Retry sign-out." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Защищённый доступ отключён, но Access Token не удалось удалить. Повторите выход." } } } },
    "Protected access is disabled, but the Access Token still needs deletion." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Защищённый доступ отключён, но Access Token всё ещё нужно удалить." } } } },
    "Protected playback is disabled. Public features remain available." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Защищённое воспроизведение отключено. Открытые функции остаются доступными." } } } },
    "Protected playback waits for Profile verification. Public features remain available." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Защищённое воспроизведение ожидает проверки профиля. Публичные функции остаются доступны." } } } },
    "Retry Access" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повторить доступ" } } } },
    "Retry Sign Out" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повторить выход" } } } },
    "Retry Verification" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повторить проверку" } } } },
    "Sign In" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Войти" } } } },
    "Sign In to Anime365" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Войти в Anime365" } } } },
    "Sign Out" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выйти" } } } },
    "Signed Out" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выполнен выход" } } } },
    "Sign-out Incomplete" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выход не завершён" } } } },
    "Subscription Active" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подписка активна" } } } },
    "Subscription Inactive" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подписка неактивна" } } } },
    "Subscription Unverified" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подписка не проверена" } } } },
    "The private Access Token could not be accessed. Public Catalogue and Watch History remain available." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет доступа к приватному Access Token. Открытый каталог и история просмотров остаются доступными." } } } },
    "Verifying Profile…" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверка профиля…" } } } },
    "Your Access Token was preserved, but Subscription Eligibility could not be verified. Retry when Anime365 is available." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Access Token сохранён, но право подписки не удалось проверить. Повторите попытку, когда Anime365 будет доступен." } } } },
    "Anime365 Catalogue" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каталог Anime365" } } } },
    "Catalogue" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каталог" } } } },
    "Catalogue Unavailable" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каталог недоступен" } } } },
    "Catalogue metadata unavailable" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Метаданные каталога недоступны" } } } },
    "Catalogue refresh failed. Older saved Series are preserved." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось обновить каталог. Сохранённые ранее сериалы доступны." } } } },
    "Close Series inspector" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрыть инспектор сериала" } } } },
    "Continue Watching is derived only from local Watch History." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "«Продолжить просмотр» создаётся только из локальной истории просмотров." } } } },
    "CONTINUE WATCHING" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ПРОДОЛЖИТЬ ПРОСМОТР" } } } },
    "Enter a Series name. Results come from Anime365." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Введите название сериала. Результаты загружаются из Anime365." } } } },
    "EPISODE" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "СЕРИЯ" } } } },
    "Episode ID" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ID серии" } } } },
    "Episodes Unavailable" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Серии недоступны" } } } },
    "Episodes will appear here after playback advances." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Серии появятся здесь после начала просмотра." } } } },
    "Explore" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Смотрите новое" } } } },
    "Find a Series" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Найти сериал" } } } },
    "Load More" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузить ещё" } } } },
    "Load More Results" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузить ещё результаты" } } } },
    "Loading Catalogue…" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка каталога…" } } } },
    "Loading Episodes…" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка серий…" } } } },
    "Loading Series…" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка сериала…" } } } },
    "Local, profile-specific playback progress" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Локальный прогресс просмотра для этого профиля" } } } },
    "No active Translations" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет активных переводов" } } } },
    "No usable snapshot is available. Refresh when you’re online." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет пригодного сохранённого каталога. Обновите его после подключения к сети." } } } },
    "No Watch History Yet" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "История просмотров пока пуста" } } } },
