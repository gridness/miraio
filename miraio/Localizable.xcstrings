    "Server-backed Series result" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Серверный результат поиска сериала" } } } },
    "Showing saved Catalogue data while one refresh runs." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранённый каталог доступен, пока выполняется одно обновление." } } } },
    "Some Catalogue data is unavailable. Valid Series are preserved." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Часть каталога недоступна. Пригодные сериалы сохранены." } } } },
    "The Series is preserved. Retry its current metadata." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сериал сохранён. Повторите загрузку актуальных метаданных." } } } },
    "TRANSLATION" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ПЕРЕВОД" } } } },
    "Translation ID" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "ID перевода" } } } },
